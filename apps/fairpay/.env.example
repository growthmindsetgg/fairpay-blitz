# TESTNET ONLY. Never put a key that holds real funds here.
# Permanent database. Supabase: Project Settings > Database > Connection string (URI, session pooler).
# Leave empty to use a local Postgres (PGlite) stored in data/pg.
DATABASE_URL=
# Needed with a Supabase DATABASE_URL: the CA that signs Supabase's certificates. The repo has it, and
# a relative path is read from apps/fairpay, so this line works on every computer.
# DATABASE_CA=certs/supabase-root-2021.crt
# The origin people open the app at (scheme and host only). Sign-in messages must name it.
# Defaults to http://localhost:5174, except with NODE_ENV=production (the Docker image), where the
# server refuses to start without it. Deployed: the website the app is served from, https://fairpay.business
PUBLIC_ORIGIN=http://localhost:5174
# Wallet that owns the demo restaurant. Defaults to MERCHANT_ADDRESS.
DEMO_OWNER_WALLET=
# RELAYER_KEY, FAUCET_KEY and MERCHANT_ADDRESS are read from apps/faireats/.env when not set here.
# Optional (defaults shown)
# PORT=8788
# Address to listen on. Loopback keeps a local run off the network; the Docker image uses 0.0.0.0.
# HOST=127.0.0.1
# RPC_URL=https://testnet-rpc.monad.xyz
# EXPLORER_URL=https://testnet.monadexplorer.com
# Contract addresses. Default: packages/contracts/deployments/monadTestnet.json
# DEPLOYMENT_FILE=../../packages/contracts/deployments/monadTestnet.json
# Reverse proxies in front of the server. 0 trusts no X-Forwarded-For. The deployed setup, the
# website (Vercel) proxying /api to Render, needs 4 (Vercel's hops plus Cloudflare and Render's
# load balancer). Never higher than the real count, or clients can pick their own rate-limit key;
# check with GET /api/whoami.
# TRUST_PROXY_HOPS=0
# Blocks on top of a pool deposit before the indexer serves it (0 on a local Hardhat node).
# INDEXER_CONFIRMATIONS=2
